# ---- Server ----
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string

# ---- Dashboard admin login (separate from Firebase Auth used by the mobile app) ----
ADMIN_USERNAME=admin
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=
# Dev-only fallback used if ADMIN_PASSWORD_HASH is not set. Do not use in production.
ADMIN_PASSWORD=admin123

# ---- Firebase Admin SDK: option A ----
# Paste the full service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Firebase Admin SDK: option B (useful on hosts like Render/Heroku) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
